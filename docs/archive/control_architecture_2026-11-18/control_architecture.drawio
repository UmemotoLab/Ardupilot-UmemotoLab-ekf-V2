                <mxCell id="p4-tu" value="上向き推力&#xa;T_u,h = (6.3157ū−0.9995)g [N]" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#F7F3EA;strokeColor=#8C6D46;strokeWidth=2;fontSize=18;fontFamily=Noto Sans CJK JP;" vertex="1" parent="1">
