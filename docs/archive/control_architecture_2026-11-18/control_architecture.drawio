                    <mxGeometry x="2230" y="225" width="120" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="p4-fixed" value="固定ゲイン経路&#xa;k_c = k_c,fixed" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFF8E7;strokeColor=#B86B00;strokeWidth=2;dashed=1;fontSize=18;fontFamily=Noto Sans CJK JP;" vertex="1" parent="1">
