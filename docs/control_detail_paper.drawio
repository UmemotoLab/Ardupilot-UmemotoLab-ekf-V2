                    <mxGeometry height="35" width="730" x="705" y="1280" as="geometry" />
                </mxCell>
                <mxCell id="forecast" data-role="process" parent="1" style="rounded=0;whiteSpace=wrap;html=0;spacing=10;align=center;verticalAlign=middle;fillColor=#FFF5E8;strokeColor=#B57B29;strokeWidth=1.5;fontSize=20;fontFamily=Noto Sans CJK JP;fontColor=#172B3A;" value="制御時刻に用いる外力を予測&#10;\(\hat F_i=d_i+\tau_p\dot d_i+c_i\quad[\mathrm{N}]\)&#10;\(\tau_p=0\) のときは現在の推定外力" vertex="1">
                    <mxGeometry height="110" width="550" x="1580" y="240" as="geometry" />
                </mxCell>
                <mxCell id="gain" data-role="process" parent="1" style="rounded=0;whiteSpace=wrap;html=0;spacing=10;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#8BA1B5;strokeWidth=1.5;fontSize=20;fontFamily=Noto Sans CJK JP;fontColor=#172B3A;" value="固定ゲインで補正量を計算&#10;\(\Delta\phi_{\mathrm{raw}}=\frac{k_c\hat F_y}{m_Q}\)&#10;\(\Delta\theta_{\mathrm{raw}}=-\frac{k_c\hat F_x}{m_Q}\)&#10;\(k_c\) は事前設定した固定ゲイン" vertex="1">
                    <mxGeometry height="150" width="550" x="1580" y="410" as="geometry" />
                </mxCell>
                <mxCell id="fade" data-role="process" parent="1" style="rounded=0;whiteSpace=wrap;html=0;spacing=10;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#8BA1B5;strokeWidth=1.5;fontSize=19;fontFamily=Noto Sans CJK JP;fontColor=#172B3A;" value="補正のフェード処理（注A）&#10;\(A_i=\sqrt{d_i^2+\left(\frac{\dot d_i}{\omega_i}\right)^2}\)&#10;小振幅が継続したら \(\alpha_i\) を徐々に0へ&#10;\(\Delta\phi_{\mathrm{f}}=\alpha_y\Delta\phi_{\mathrm{raw}},\quad\Delta\theta_{\mathrm{f}}=\alpha_x\Delta\theta_{\mathrm{raw}}\)&#10;\(0\leq\alpha_i\leq1\)" vertex="1">
                    <mxGeometry height="170" width="550" x="1580" y="610" as="geometry" />
                </mxCell>
