        <mxCell id="predict" data-role="process" parent="1" style="rounded=0;whiteSpace=wrap;html=0;spacing=10;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#8BA1B5;strokeWidth=1.5;fontSize=20;fontFamily=Noto Sans CJK JP;fontColor=#172B3A;" value="状態の予測（シンプレクティックEuler）&#10;\(\dot d^{-}=\dot d-\Delta t\,\omega^2 d\)&#10;\(d^{-}=d+\Delta t\,\dot d^{-},\quad c^{-}=c,\quad\omega^{-}=\omega\)&#10;\(\omega\)は設定範囲内で予測" vertex="1">
          <mxGeometry height="130" width="650" x="740" y="380" as="geometry" />
