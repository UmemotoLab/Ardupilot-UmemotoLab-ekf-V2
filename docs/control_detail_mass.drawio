        <mxCell data-role="label" style="rounded=0;whiteSpace=wrap;html=0;spacing=10;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;strokeWidth=1.5;fontSize=23;fontFamily=Noto Sans CJK JP;fontColor=#172B3A;align=left;fontColor=#624079;fontStyle=1;" id="mass_heading" value="D　ホバー条件に応じた吊り荷質量推定とゲイン設定" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1390" width="2020" height="42" />
