          <mxGeometry height="100" width="650" x="740" y="555" as="geometry" />
        </mxCell>
        <mxCell id="innovation" data-role="process" parent="1" style="rounded=0;whiteSpace=wrap;html=0;spacing=10;align=center;verticalAlign=middle;fillColor=#FFF5E8;strokeColor=#B57B29;strokeWidth=1.5;fontSize=20;fontFamily=Noto Sans CJK JP;fontColor=#172B3A;" value="観測残差の計算とクリップ（注B）&#10;\(r=z_i-(d^{-}+c^{-})\)&#10;\(r_{\mathrm{used}}=\operatorname{clip}(r,-r_{\max},r_{\max})\)" vertex="1">
          <mxGeometry height="100" width="650" x="740" y="690" as="geometry" />
        </mxCell>
        <mxCell id="update" data-role="process" parent="1" style="rounded=0;whiteSpace=wrap;html=0;spacing=10;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#8BA1B5;strokeWidth=1.5;fontSize=19;fontFamily=Noto Sans CJK JP;fontColor=#172B3A;" value="カルマンゲイン・状態・共分散を更新&#10;\(\boldsymbol{H}=[1,0,1,0],\quad S=\boldsymbol{H}\boldsymbol{P}^{-}\boldsymbol{H}^{\mathsf T}+R\)&#10;\(\boldsymbol{K}=\frac{\boldsymbol{P}^{-}\boldsymbol{H}^{\mathsf T}}{S}\)&#10;\(\boldsymbol{x}^{+}=\boldsymbol{x}^{-}+\boldsymbol{K}r_{\mathrm{used}},\quad\boldsymbol{P}^{+}=(\boldsymbol{I}-\boldsymbol{K}\boldsymbol{H})\boldsymbol{P}^{-}\)" vertex="1">
          <mxGeometry height="140" width="650" x="740" y="845" as="geometry" />
